# Buddy AI Desk Pet - Environment Variables

# ElevenLabs TTS
ELEVENLABS_API_KEY=your_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# Deepgram STT
DEEPGRAM_API_KEY=your_key_here

# LLM via Lava API Gateway
LAVA_API_KEY=your_key_here
LAVA_BASE_URL=https://api.lava.ai/v1

# Arduino serial port (auto-detected if not set)
ARDUINO_SERIAL_PORT=/dev/ttyACM0
ARDUINO_BAUD_RATE=9600

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# Webcam device index
WEBCAM_INDEX=0
